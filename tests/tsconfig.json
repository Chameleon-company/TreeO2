{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}