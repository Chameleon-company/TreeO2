model TreeType {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(200)
  key              String?  @db.VarChar(200)
  scientificName   String?  @map("scientific_name") @db.VarChar(200)
  dryWeightDensity Decimal? @map("dry_weight_density") @db.Decimal(8, 3)
  minHeightM       Decimal? @map("min_height_m") @db.Decimal(12, 3)
  maxHeightM       Decimal? @map("max_height_m") @db.Decimal(12, 3)
  minDiameterCm    Decimal? @map("min_diameter_cm") @db.Decimal(12, 3)
  maxDiameterCm    Decimal? @map("max_diameter_cm") @db.Decimal(12, 3)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  projectTreeTypes ProjectTreeType[]
  treeScans        TreeScan[]        @relation("SpeciesTreeScans")

  @@map("tree_types")
}
