model Project {
  id                  Int      @id @default(autoincrement())
  ownerOrganisationId Int      @map("owner_organisation_id")
  name                String   @db.VarChar(255)
  description         String?
  countryId           Int?     @map("country_id")
  adminLocationId     Int?     @map("admin_location_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  country              Country?              @relation("ProjectCountry", fields: [countryId], references: [id], onDelete: Restrict)
  adminLocation        Location?             @relation("ProjectAdminLocation", fields: [adminLocationId], references: [id], onDelete: Restrict)
  ownerOrganisation    Organisation          @relation(fields: [ownerOrganisationId], references: [id], onDelete: Restrict)
  userProjects         UserProject[]
  projectTreeTypes     ProjectTreeType[]
  projectOrganisations ProjectOrganisation[]
  scanBatches          ScanBatch[]           @relation("ProjectScanBatches")
  treeScans            TreeScan[]            @relation("ProjectTreeScans")

  userProjectRoles UserProjectRole[]

  @@index([countryId])
  @@index([adminLocationId])
  @@map("projects")
}
